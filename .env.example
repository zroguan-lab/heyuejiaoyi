# 主行情源必须与未来执行交易所一致；辅助源只做校验，不会静默替代
PRIMARY_MARKET_PROVIDER=binance
AUXILIARY_MARKET_PROVIDER=hyperliquid
MONITOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MONITOR_INTERVAL=15m
POLL_SECONDS=30
CANDLE_LIMIT=300
SCAN_CONCURRENCY=5

# 市场雷达R2每15分钟评估100个高流动性USDT永续，按已收盘K线的1H涨跌榜、排名速度与量能异动选30个做深度扫描
DYNAMIC_UNIVERSE=true
UNIVERSE_SIZE=30
UNIVERSE_REFRESH_HOURS=168
UNIVERSE_MIN_LISTING_DAYS=90
UNIVERSE_MAX_SPREAD_BPS=20
MARKET_RADAR_ENABLED=true
MARKET_RADAR_DISCOVERY_SIZE=100
MARKET_RADAR_REFRESH_MINUTES=15
MARKET_RADAR_MINIMUM_HOLD_MINUTES=30
MARKET_RADAR_CORE_MIN_SCORE=68
MARKET_RADAR_REQUIRED_FOR_V2=true
MARKET_RADAR_MOVER_CANDLE_LIMIT=33
MARKET_RADAR_GAINER_COUNT=15
MARKET_RADAR_LOSER_COUNT=15
MARKET_RADAR_RANK_VELOCITY_COUNT=10
MARKET_RADAR_VOLUME_SHOCK_COUNT=10
MARKET_RADAR_MIN_VOLUME_SHOCK_RATIO=1.2

# 模拟组合；不设置固定持仓笔数，只有达到评分门槛并通过执行校验的信号才会自动提交
SIMULATED_EQUITY_USDT=500
MARGIN_PER_TRADE_USDT=10
LEVERAGE=10
WINDOWS_NOTIFICATIONS=true
FALLBACK_TAKER_FEE_RATE=0.0005
FALLBACK_SLIPPAGE_RATE=0.0002
ACTIVE_LIMIT_MAX_BPS=10
PULLBACK_ENTRY_TTL_SECONDS=180

# 本地面板
HOST=127.0.0.1
PORT=3000

# 策略参数
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
MIN_CONFIDENCE=70
ATR_STOP_MULTIPLIER=1.5
MIN_STOP_PERCENT=0.15
MAX_STOP_PERCENT=4
TAKE_PROFIT_RR_1=1.5
TAKE_PROFIT_RR_2=2.5
RISK_PER_TRADE_PERCENT=1

# V2.4 Pre-Move研究账本自身不发单；V2_PRODUCTION适配器只把评分与成本门控通过的信号提升到Binance Demo
SHADOW_V2_ENABLED=true
SHADOW_V2_CORE_MIN_SCORE=70
SHADOW_V2_EXPLORATION_MIN_SCORE=55
SHADOW_V2_SAMPLE_TARGET=100
SHADOW_V2_RISK_PERCENT=0.5
SHADOW_V2_MAX_COST_R=0.2
SHADOW_V2_MAX_FUNDING_COST_R=0.1
SHADOW_V2_EXTREME_COST_R=0.35
SHADOW_V2_EXTREME_FUNDING_COST_R=0.2
SHADOW_V2_EXPECTED_HOLDING_HOURS=12
SHADOW_V2_BREAKOUT_MAX_DISTANCE_ATR=0.8
SHADOW_V2_BREAKOUT_MAX_BODY_ATR=1.2
SHADOW_V2_BREAKOUT_EXTREME_DISTANCE_ATR=1.5
SHADOW_V2_BREAKOUT_EXTREME_BODY_ATR=2
SHADOW_V2_PULLBACK_MAX_DEPTH_ATR=0.6
SHADOW_V2_PULLBACK_MAX_TRIGGER_DISTANCE_ATR=0.8
SHADOW_V2_PULLBACK_EXTREME_DEPTH_ATR=1.5
SHADOW_V2_PULLBACK_EXTREME_TRIGGER_DISTANCE_ATR=1.5
V2_4_MAX_BOUNDARY_DISTANCE_ATR=1.2
V2_4_MAX_COMPRESSION_RATIO=1.25
V2_4_MIN_EXPLOSION_SCORE=40
V2_4_MIN_DIRECTION_SCORE=48
V2_4_HARD_MIN_EXPLOSION_SCORE=35
V2_4_HARD_MIN_DIRECTION_SCORE=42
MARKET_RADAR_REFRESH_MINUTES=5
MARKET_RADAR_COMPRESSION_COUNT=15
MARKET_RADAR_BOUNDARY_PRESSURE_COUNT=15
MARKET_RADAR_EARLY_ACCELERATION_COUNT=10

# 可选：自定义行情网关
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
OKX_BASE_URL=https://openapi.okx.com
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
REQUEST_TIMEOUT_MS=10000

# V2.4历史研究数据与Demo交易库完全分离；该域名只允许Binance生产公共只读行情接口
BINANCE_RESEARCH_BASE_URL=https://fapi.binance.com
HISTORICAL_DATA_ROOT=research-data
# 独立公共只读历史事实采集器；默认与V2.4雷达同为5分钟，合约规则每天留一份
HISTORICAL_FACT_INTERVAL_MINUTES=5
HISTORICAL_FACT_SETTLE_SECONDS=10
HISTORICAL_FACT_CONTRACT_REFRESH_HOURS=24
HISTORICAL_BACKFILL_REQUEST_INTERVAL_MS=500
HISTORICAL_BACKFILL_RATE_LIMIT_RETRIES=8

# 可选：Node.js 不会自动继承 Windows 系统代理；使用 Clash 等本地代理时显式配置
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=127.0.0.1,localhost

# Binance Demo/Testnet 只读账户；当前版本即使误设执行开关也会拒绝启动
BINANCE_TESTNET_ACCOUNT_READ_ONLY=false
BINANCE_TESTNET_ACCOUNT_POLL_SECONDS=60
BINANCE_TESTNET_RECV_WINDOW_MS=60000
BINANCE_TESTNET_EXECUTION_ENABLED=false
# 仅当上面的测试网写入锁为 true 时有效；只自动执行新产生、已选入模拟组合且未过期的信号
BINANCE_TESTNET_AUTO_EXECUTION_ENABLED=false
# V1_ALL_ELIGIBLE 或 V2_PRODUCTION；V2 只提升明确入选且晚于当前绩效纪元的信号
BINANCE_TESTNET_EXECUTION_STRATEGY=V1_ALL_ELIGIBLE
BINANCE_TESTNET_CANARY_POLL_SECONDS=15
BINANCE_TESTNET_CANARY_SYMBOL=BTCUSDT
BINANCE_TESTNET_CANARY_MARGIN_USDT=10
BINANCE_TESTNET_CANARY_LEVERAGE=10
BINANCE_TESTNET_MAX_NOTIONAL_OVERAGE_RATE=0.05
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
SIGNAL_STORE_PATH=data/signals.jsonl
RESEARCH_DATABASE_PATH=data/research.sqlite
# V2.4.3只新增BOUNDARY_PRESSURE-only过滤；RETAINED过滤与LONG确认参数保持不变
V2_4_1_LONG_MIN_VOLUME_RATIO_15M=1
V2_4_1_LONG_MIN_VOLUME_ACCELERATION_5M=1
V2_4_1_LONG_MAX_COMPRESSION_RATIO=1
V2_4_1_LONG_MIN_DIRECTIONAL_PRESSURE=0.55
V2_4_1_LONG_MIN_LATEST_BODY_ATR=0.05
V2_4_1_LONG_MIN_LATEST_CLOSE_CHANGE_ATR=0
V2_4_1_LONG_MIN_LATEST_CLOSE_LOCATION=0.5
